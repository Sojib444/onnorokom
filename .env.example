# Copy this file to .env and replace every value before starting the stack.
# .env is git-ignored; only this example is committed.
#
#   copy .env.example .env   (Windows:  Copy-Item .env.example .env)
#   docker compose up --build

# ---- PostgreSQL -----------------------------------------------------------------
POSTGRES_DB=assignmentmanagement
POSTGRES_USER=assignment
POSTGRES_PASSWORD=ChangeMe_Postgres_123!

# Connection string used by the API container. Host MUST be the compose service name
# "postgres" - localhost inside a container refers to that container itself.
# Keep this in sync with the three POSTGRES_* values above.
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=assignmentmanagement;Username=assignment;Password=ChangeMe_Postgres_123!

# ---- JWT ------------------------------------------------------------------------
# Must be at least 32 characters for the API to start.
JWT_SECRET=ChangeMe_At_Least_32_Characters_Jwt_Secret_0123456789
JWT_ISSUER=AssignmentManagement.Api
JWT_AUDIENCE=AssignmentManagement.Client
JWT_EXPIRES_MINUTES=60

# ---- API / CORS -----------------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly (CORS). The Docker
# frontend at :8080 needs no CORS (it reaches /api same-origin via nginx); this only
# matters for direct calls to the API at :5105 from another origin, such as the Angular
# dev server (:4200) or the Docker frontend itself.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# ---- Ports ----------------------------------------------------------------------
# Host ports mapped onto the containers. Frontend is the entry point; the API is also
# exposed directly so Swagger (http://localhost:5105/swagger) is reachable.
FRONTEND_PORT=8080
API_PORT=5105
# Host port for the mapped Postgres port. Defaults to 5433 because a locally installed
# PostgreSQL usually already owns 5432. Set to 5432 to use the standard port.
POSTGRES_PORT=5433
